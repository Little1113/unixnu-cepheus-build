 	return touch_msg(TOUCH_I2C_ADDR, NULL, 0, buf, len, false);
+}
+
+/* FTM5 I2C framebuffer read: 0xA6 + 16-bit address, no dummy byte.
+ * Uses only documented read operations; never requests load/calibration/flash. */
+static int
+touch_read_memory(uint16_t address, uint8_t *buf, unsigned len)
+{
+	if (!st.gpio_i2c || !len || len > 256 || (uint32_t)address + len > 0x10000u) { return EINVAL; }
+	const uint8_t cmd[] = {0xa6, (uint8_t)(address >> 8), (uint8_t)address};
+	return cepheus_bb_xfer(&touch_bb, TOUCH_I2C_ADDR, cmd, sizeof(cmd), buf, len);
+}
+
+static int
+touch_info_frame(const char *label, uint16_t addr, unsigned words)
+{
+	if (!cepheus_info_range(addr, words)) {
+		printf("CEPHEUS SENSOR: %s invalid range addr=%#x words=%u\n", label, addr, words);
+		return 0; /* Invalid firmware metadata is not a bus error. */
+	}
+	uint8_t data[2 * CEPHEUS_CHANNEL_LIMIT] = {0};
+	int err = touch_read_memory(addr, data, 2 * words);
+	if (err) { printf("CEPHEUS SENSOR: %s read err=%d\n", label, err); return err; }
+	struct cepheus_fts_stats stats;
+	if (!cepheus_info_stats(data, 2 * words, &stats)) { return EINVAL; }
+	printf("CEPHEUS SENSOR: %s addr=%#x n=%u min=%d max=%d hash=%#x\n",
+	    label, addr, words, stats.min, stats.max, stats.hash);
+	/* Up to the first eight samples; do not flood the event log. */
+	for (unsigned i = 0; i < words && i < 8; ++i) {
+		printf("CEPHEUS SAMPLE: %s [%u]=%d\n", label, i, cepheus_info_s16(data + 2 * i));
+	}
+	return 0;
+}
+
+static void
+touch_info_snapshot(unsigned snapshot)
+{
+	uint8_t data[CEPHEUS_SYSINFO_SIZE] = {0};
+	int err = touch_read_memory(0, data, sizeof(data));
+	printf("CEPHEUS SYSINFO: snapshot=%u read=%d header=%02x:%02x:%02x:%02x\n",
+	    snapshot, err, data[0], data[1], data[2], data[3]);
+	if (err) { return; }
+	struct cepheus_fts_info info;
+	if (!cepheus_info_parse(data, sizeof(data), &info)) { return; }
+	printf("CEPHEUS SYSINFO: fw=%04x cfg=%04x project=%04x cx=%04x cxproject=%04x afe=%02x:%02x:%02x proto=%02x crc=%08x:%08x xy=%u,%u tx=%u rx=%u dbg=%04x\n",
+	    info.fw, info.cfg, info.project, info.cx, info.cx_project,
+	    info.cfg_afe, info.cx_afe, info.panel_afe, info.protocol, info.fw_crc, info.cfg_crc,
+	    info.x, info.y, info.tx, info.rx, info.debug_addr);
+	uint8_t crc = 0;
+	err = fts_read_hw(0x20000078u, &crc, 1);
+	printf("CEPHEUS SYSINFO: hardware-crc read=%d value=%02x\n", err, crc);
+	if (err) { return; }
+	if (touch_info_frame("ms-raw-row0", info.ms_raw, info.rx)) { return; }
+	if (touch_info_frame("ms-strength-row0", info.ms_strength, info.rx)) { return; }
+	if (touch_info_frame("ss-tx-raw", info.ss_tx_raw, info.tx)) { return; }
+	if (touch_info_frame("ss-tx-strength", info.ss_tx_strength, info.tx)) { return; }
+	if (touch_info_frame("ss-rx-raw", info.ss_rx_raw, info.rx)) { return; }
+	(void)touch_info_frame("ss-rx-strength", info.ss_rx_strength, info.rx);
 }
 
